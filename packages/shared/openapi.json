{
  "components": {
    "schemas": {
      "CompleteEvent": {
        "properties": {
          "plan": {
            "$ref": "#/components/schemas/Plan"
          },
          "type": {
            "const": "complete",
            "default": "complete",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "plan"
        ],
        "title": "CompleteEvent",
        "type": "object"
      },
      "ErrorEvent": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "const": "error",
            "default": "error",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "ErrorEvent",
        "type": "object"
      },
      "ErrorItem": {
        "description": "One field-level problem. Never echoes the offending input value.",
        "properties": {
          "field": {
            "description": "Dotted location, e.g. 'body.location.lat'.",
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "description": "Machine-readable validation error type.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message",
          "type"
        ],
        "title": "ErrorItem",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "description": "Stable machine-readable code, e.g. 'validation_error'.",
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "description": "Human-readable summary.",
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErrorItem"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Matches the X-Request-ID header.",
            "title": "Request Id"
          }
        },
        "required": [
          "detail",
          "code"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "GeoPoint": {
        "properties": {
          "lat": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lon",
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "title": "GeoPoint",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "environment"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[^@\\s]+@[^@\\s]+$",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "Plan": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "legs": {
            "items": {
              "$ref": "#/components/schemas/TravelLeg"
            },
            "title": "Legs",
            "type": "array"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "title": "Notes",
            "type": "array"
          },
          "prompt": {
            "title": "Prompt",
            "type": "string"
          },
          "saved": {
            "default": false,
            "title": "Saved",
            "type": "boolean"
          },
          "stops": {
            "items": {
              "$ref": "#/components/schemas/PlanStop"
            },
            "title": "Stops",
            "type": "array"
          },
          "summary": {
            "$ref": "#/components/schemas/PlanSummary"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "prompt",
          "stops",
          "legs",
          "summary",
          "created_at"
        ],
        "title": "Plan",
        "type": "object"
      },
      "PlanRequest": {
        "properties": {
          "city": {
            "anyOf": [
              {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GeoPoint"
              },
              {
                "type": "null"
              }
            ]
          },
          "prompt": {
            "maxLength": 1000,
            "minLength": 3,
            "title": "Prompt",
            "type": "string"
          }
        },
        "required": [
          "prompt"
        ],
        "title": "PlanRequest",
        "type": "object"
      },
      "PlanStop": {
        "properties": {
          "category": {
            "title": "Category",
            "type": "string"
          },
          "cost": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost"
          },
          "cost_source": {
            "default": "unknown",
            "enum": [
              "osm_tag",
              "estimate",
              "unknown"
            ],
            "title": "Cost Source",
            "type": "string"
          },
          "duration_min": {
            "minimum": 0.0,
            "title": "Duration Min",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "location": {
            "$ref": "#/components/schemas/GeoPoint"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "opening_hours_verified": {
            "default": false,
            "title": "Opening Hours Verified",
            "type": "boolean"
          },
          "osm_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Osm Id"
          },
          "osm_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Osm Url"
          },
          "rating": {
            "anyOf": [
              {
                "maximum": 5.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          },
          "start": {
            "format": "date-time",
            "title": "Start",
            "type": "string"
          },
          "why": {
            "title": "Why",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "location",
          "start",
          "duration_min",
          "why"
        ],
        "title": "PlanStop",
        "type": "object"
      },
      "PlanStreamEvent": {
        "description": "One server-sent event of a plan or revision stream.",
        "discriminator": {
          "mapping": {
            "complete": "#/components/schemas/CompleteEvent",
            "error": "#/components/schemas/ErrorEvent",
            "status": "#/components/schemas/StatusEvent",
            "stop": "#/components/schemas/StopEvent"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/StatusEvent"
          },
          {
            "$ref": "#/components/schemas/StopEvent"
          },
          {
            "$ref": "#/components/schemas/CompleteEvent"
          },
          {
            "$ref": "#/components/schemas/ErrorEvent"
          }
        ],
        "title": "PlanStreamEvent"
      },
      "PlanSummary": {
        "properties": {
          "budget_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget Note"
          },
          "budget_status": {
            "default": "not_set",
            "enum": [
              "not_set",
              "within",
              "over",
              "unverified"
            ],
            "title": "Budget Status",
            "type": "string"
          },
          "cost_status": {
            "default": "unknown",
            "enum": [
              "known",
              "partial",
              "unknown"
            ],
            "title": "Cost Status",
            "type": "string"
          },
          "currency": {
            "default": "INR",
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          },
          "total_cost": {
            "minimum": 0.0,
            "title": "Total Cost",
            "type": "number"
          },
          "total_duration_min": {
            "minimum": 0.0,
            "title": "Total Duration Min",
            "type": "integer"
          },
          "total_travel_min": {
            "minimum": 0.0,
            "title": "Total Travel Min",
            "type": "integer"
          },
          "unpriced_stops": {
            "default": 0,
            "minimum": 0.0,
            "title": "Unpriced Stops",
            "type": "integer"
          }
        },
        "required": [
          "total_cost",
          "total_duration_min",
          "total_travel_min"
        ],
        "title": "PlanSummary",
        "type": "object"
      },
      "ReadinessCheck": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "ok"
        ],
        "title": "ReadinessCheck",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/ReadinessCheck"
            },
            "title": "Checks",
            "type": "array"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "ReviseRequest": {
        "properties": {
          "action": {
            "enum": [
              "cheaper",
              "less_walking",
              "add_activity",
              "swap_stop",
              "custom"
            ],
            "title": "Action",
            "type": "string"
          },
          "instruction": {
            "anyOf": [
              {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instruction"
          },
          "stop_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stop Id"
          }
        },
        "required": [
          "action"
        ],
        "title": "ReviseRequest",
        "type": "object"
      },
      "SavedPlanItem": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "summary": {
            "$ref": "#/components/schemas/PlanSummary"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "created_at",
          "summary"
        ],
        "title": "SavedPlanItem",
        "type": "object"
      },
      "StatusEvent": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "step": {
            "enum": [
              "understanding",
              "finding_places",
              "scoring",
              "checking_routes",
              "writing"
            ],
            "title": "Step",
            "type": "string"
          },
          "type": {
            "const": "status",
            "default": "status",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "step",
          "message"
        ],
        "title": "StatusEvent",
        "type": "object"
      },
      "StopEvent": {
        "properties": {
          "leg_from_previous": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TravelLeg"
              },
              {
                "type": "null"
              }
            ]
          },
          "stop": {
            "$ref": "#/components/schemas/PlanStop"
          },
          "type": {
            "const": "stop",
            "default": "stop",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "stop"
        ],
        "title": "StopEvent",
        "type": "object"
      },
      "TravelLeg": {
        "properties": {
          "distance_m": {
            "minimum": 0.0,
            "title": "Distance M",
            "type": "integer"
          },
          "duration_min": {
            "minimum": 0.0,
            "title": "Duration Min",
            "type": "integer"
          },
          "from_stop_id": {
            "title": "From Stop Id",
            "type": "string"
          },
          "geometry": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "title": "Geometry",
            "type": "array"
          },
          "mode": {
            "enum": [
              "walk",
              "bike",
              "transit",
              "drive"
            ],
            "title": "Mode",
            "type": "string"
          },
          "source": {
            "default": "estimate",
            "enum": [
              "route",
              "estimate"
            ],
            "title": "Source",
            "type": "string"
          },
          "to_stop_id": {
            "title": "To Stop Id",
            "type": "string"
          }
        },
        "required": [
          "from_stop_id",
          "to_stop_id",
          "mode",
          "distance_m",
          "duration_min"
        ],
        "title": "TravelLeg",
        "type": "object"
      },
      "User": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email"
        ],
        "title": "User",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Itinerary generation from real OpenStreetMap places.",
    "title": "ExploreAI API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "description": "On success the API sets an httpOnly session cookie (no token in JS).",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request validation failed."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request validation failed."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "getMe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request validation failed."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "Get Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Liveness: the process is up. Never touches dependencies.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request validation failed."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "Get Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/plans/saved": {
      "get": {
        "operationId": "listSavedPlans",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SavedPlanItem"
                  },
                  "title": "Response Listsavedplans",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request validation failed."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "List Saved Plans",
        "tags": [
          "plans"
        ]
      }
    },
    "/api/v1/plans/stream": {
      "post": {
        "operationId": "streamPlan",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanStreamEvent"
                }
              },
              "text/event-stream": {}
            },
            "description": "Server-sent events; each `data:` line is a PlanStreamEvent JSON object."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request validation failed."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "Stream Plan",
        "tags": [
          "plans"
        ]
      }
    },
    "/api/v1/plans/{plan_id}": {
      "get": {
        "operationId": "getPlan",
        "parameters": [
          {
            "in": "path",
            "name": "plan_id",
            "required": true,
            "schema": {
              "title": "Plan Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request validation failed."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "Get Plan",
        "tags": [
          "plans"
        ]
      }
    },
    "/api/v1/plans/{plan_id}/revise/stream": {
      "post": {
        "operationId": "streamRevision",
        "parameters": [
          {
            "in": "path",
            "name": "plan_id",
            "required": true,
            "schema": {
              "title": "Plan Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
