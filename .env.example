# ExploreAI environment. Copy to `.env` (never commit it): cp .env.example .env
# Every variable here is read by apps/api (Settings) or apps/web (NEXT_PUBLIC_*).

# ---------------------------------------------------------------- General
# Runtime environment: development | test | production
APP_ENV=development
# Python log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# auto = JSON lines in production, readable text otherwise | json | console
LOG_FORMAT=auto
# Contact string put in the User-Agent of every outbound call. REQUIRED by the
# Nominatim/Overpass usage policies: use a real email or project URL.
HTTP_USER_AGENT=ExploreAI/0.1 (+mailto:you@example.com)
# Comma-separated origins allowed by CORS on the API.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- Postgres (PostGIS)
POSTGRES_USER=exploreai
POSTGRES_PASSWORD=exploreai
POSTGRES_DB=exploreai
# Host port published by docker compose.
POSTGRES_PORT=5432
# SQLAlchemy-style async URL. Inside compose the host is `postgres`, not localhost.
DATABASE_URL=postgresql+asyncpg://exploreai:exploreai@localhost:5432/exploreai

# ---------------------------------------------------------------- Redis (cache)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# Default cache TTL in seconds for external API responses.
CACHE_DEFAULT_TTL_SECONDS=86400

# ---------------------------------------------------------------- LLM (provider-agnostic)
# Ordered, comma-separated provider chain; first healthy one wins.
# Implemented: gemini (others are skipped until added)
LLM_PROVIDER_CHAIN=gemini
# Free-tier API keys. Leave blank to skip that provider. No card required.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Model names are config, never code. Override as free-tier offerings change.
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Local fallback.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Per-call timeout (seconds) for LLM requests.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------- Geo / data APIs (all free, keyless unless noted)
# Overpass: use a public instance gently, or self-host.
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Photon geocoder (autocomplete-safe). Nominatim is for rare lookups only (<=1 req/s).
PHOTON_URL=https://photon.komoot.io
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Routing: OSRM public demo is for light dev use only; self-host for production.
# The public demo serves the CAR profile only, so OSRM_URL is used for drive legs.
OSRM_URL=https://router.project-osrm.org
# Walk/bike need their own OSRM instances (base URL + profile name). Blank = no router for that
# mode: those legs are then straight-line ESTIMATES, labelled as such in the plan.
OSRM_WALK_URL=
OSRM_WALK_PROFILE=foot
OSRM_BIKE_URL=
OSRM_BIKE_PROFILE=bike
# Optional OpenRouteService key (free signup, no card). Blank = disabled.
ORS_API_KEY=
# Weather (no key).
OPEN_METEO_URL=https://api.open-meteo.com
# Shared timeout and retry settings for data API calls.
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=2

# ---------------------------------------------------------------- Planner
# false = /plans/stream ends with an explicit "not available" error (no builder installed).
PLANNER_ENABLED=true
# Whole-request budget for /plans/stream (seconds). Public Overpass can take ~20 s.
PIPELINE_TIMEOUT_SECONDS=120
# Plans start "now" in this fixed UTC offset; opening hours are read in the same offset.
# 330 = India. No DST / tz database: set it to match where your users are.
PLAN_UTC_OFFSET_MINUTES=330
# Cap on elements requested from Overpass per search.
OVERPASS_MAX_ELEMENTS=300

# ---------------------------------------------------------------- Web (apps/web)
# Browser-visible API base URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Free vector tile style (no key). Keep OSM/OpenFreeMap attribution visible.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Host ports published by docker compose.
API_PORT=8000
WEB_PORT=3000
